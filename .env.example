# Bu dosyayı .env adıyla kopyala:  cp .env.example .env
# .env dosyası .gitignore'da; içindeki şifreler/anahtarlar repoya girmez.

# --- PostgreSQL (docker-compose bu değerleri kullanır) ---
POSTGRES_HOST=localhost
# 5432 Olist projesinde kullanılıyor; çakışmasın diye 5433
POSTGRES_PORT=5433
POSTGRES_DB=superstore

# Yönetici kullanıcı: sadece tablo oluşturma ve veri yükleme için
POSTGRES_ADMIN_USER=superstore_admin
POSTGRES_ADMIN_PASSWORD=superstore_admin_local_pw

# Salt-okunur kullanıcı: agent'lar bununla bağlanır
POSTGRES_READER_USER=superstore_reader
POSTGRES_READER_PASSWORD=superstore_reader_local_pw

# --- Claude API ---
# https://console.anthropic.com adresinden alınır
ANTHROPIC_API_KEY=

# Tüm agent'ların kullandığı model
CLAUDE_MODEL=claude-opus-5-5
